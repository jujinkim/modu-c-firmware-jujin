#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
// -----------------------------------------------------------------
// |ESC | 1  | 2  | 3  | 4  | 5  |   | 6  | 7  | 8  | 9  | 0  |DEL |
// |TAB | Q  | W  | E  | R  | T  |   | Y  | U  | I  | O  | P  |HOME|
// |CAPS| A  | S  | D  | F  | G  |   | H  | J  | K  | L  | ;  |PGUP|
// |LSFT| Z  | X  | C  | V  | B  |   | N  | M  | ,  | .  | /  |PGDN|
// |LCTL|LALT|LGUI|                                 |RALT|RCTL|END |
//                |MO1 |LANG|SPC |   |BSPC|RET |MO1 | B  |
            bindings = <
&kp ESC   &kp N1   &kp N2    &kp N3    &kp N4    &kp N5      &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp DEL
&kp TAB   &kp Q    &kp W     &kp E     &kp R     &kp T       &kp Y     &kp U     &kp I     &kp O     &kp P     &kp BSPC
&kp CAPS  &kp A    &kp S     &kp D     &kp F     &kp G       &kp H     &kp J     &kp K     &kp L     &kp SEMI  &kp SQT
&kp LSHFT &kp Z    &kp X     &kp C     &kp V     &kp B       &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH  &kp RSHFT
&kp LCTRL &kp LALT &kp LGUI  &none     &none     &none       &none     &none     &none     &kp RALT  &kp RCTRL &kp RET
                             &mo 2     &kp SPACE &mo 1   &mo 1  &kp SPACE   &mo 1    &kp B
            >;
        };

        lower_layer {
            bindings = <
&trans   &kp F1  &kp F2    &kp F3    &kp F4    &kp F5                   &kp F6    &kp F7    &kp F8    &kp F9   &kp F10   &kp BSLH
&trans   &kp F11   &kp HOME    &kp UP    &kp END   &kp N6                &mkp RCLK      &kp HOME    &kp UP    &kp END   &kp LBKT        &kp RBKT
&trans   &kp F12   &kp LEFT    &kp DOWN    &kp RIGHT   &trans            &mkp MCLK     &kp LEFT    &kp DOWN    &kp RIGHT   &kp MINUS       &kp EQUAL 
&trans &trans &trans &trans &trans  &trans        &mkp LCLK   &kp C_AC_BACK    &kp INS    &kp C_AC_FORWARD    &trans        &trans
&trans   &trans  &trans    &trans    &trans    &trans      &trans       &trans    &trans    &trans    &trans      &trans
                            &trans    &trans    &trans      &trans      &trans    &trans   &trans
            >;
        };

        feature {
            display-name = "Feature";
            bindings = <
                &trans  &kp C_PREV  &kp C_PP  &kp C_NEXT  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &kp C_MUTE  &kp C_VOL_DN  &kp C_VOL_UP  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

    };
};
