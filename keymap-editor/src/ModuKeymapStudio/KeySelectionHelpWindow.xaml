<Window x:Class="ModuKeymapStudio.KeySelectionHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="키 선택 도움말 · Unofficial MODU Keymap Studio"
        Width="660" Height="720" MinWidth="620" MinHeight="560" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
    <Grid Margin="27">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel>
            <Border DockPanel.Dock="Left" Width="42" Height="42" CornerRadius="21"
                    Background="{DynamicResource AccentBrush}" Margin="0,0,13,0">
                <TextBlock Text="?" Foreground="{DynamicResource AccentForegroundBrush}" FontSize="23" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="키 선택 도움말" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="키코드의 차이와 지연 키 설정·사용법을 확인하세요."
                           Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0" />
            </StackPanel>
        </DockPanel>

        <TabControl Grid.Row="1" x:Name="HelpTabs" Margin="0,21,0,0">
            <TabItem Header="키코드">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,12,8,0" FontWeight="Normal">
                    <StackPanel>
                        <Border Background="{DynamicResource InfoPanelBrush}" BorderBrush="{DynamicResource InfoBorderBrush}" BorderThickness="1"
                                CornerRadius="9" Padding="16,13" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="K_와 C_의 차이" FontWeight="SemiBold" Foreground="{DynamicResource InfoTextBrush}" />
                                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="20">
                                    <Run Text="K_" FontFamily="Consolas" FontWeight="SemiBold" /><Run Text="는 일반 Keyboard/Keypad HID, "/><Run Text="C_" FontFamily="Consolas" FontWeight="SemiBold" /><Run Text="는 볼륨·재생·밝기 같은 Consumer Control HID입니다. 같은 기능명도 운영체제와 앱이 한쪽 신호만 인식할 수 있습니다." />
                                </TextBlock>
                                <TextBlock Margin="0,7,0,0" TextWrapping="Wrap" FontWeight="SemiBold"
                                           Text="미디어와 앱 제어는 일반적으로 C_ 변형을 먼저 선택하세요." />
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="9" Padding="16,13" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="자주 헷갈리는 Back 예시" FontWeight="SemiBold" />
                                <TextBlock Margin="0,7,0,0" TextWrapping="Wrap" LineHeight="21">
                                    <Run Text="C_AC_BACK" FontFamily="Consolas" FontWeight="SemiBold" /><Run Text="  Consumer Application Control 방식의 앱·브라우저 뒤로 이동" />
                                    <LineBreak />
                                    <Run Text="K_BACK" FontFamily="Consolas" FontWeight="SemiBold" /><Run Text="  Keyboard HID 방식의 별도 Back 키" />
                                    <LineBreak />
                                    <Run Text="BSPC" FontFamily="Consolas" FontWeight="SemiBold" /><Run Text="  탐색이 아니라 앞 문자를 지우는 Backspace" />
                                </TextBlock>
                                <TextBlock Margin="0,7,0,0" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                                           Text="C_AC_의 AC는 Alt/Ctrl이 아니라 Application Control을 뜻합니다." />
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource WarningPanelBrush}" BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1"
                                CornerRadius="9" Padding="16,12" Margin="0,0,0,16">
                            <TextBlock TextWrapping="Wrap" LineHeight="20">
                                <Run Text="호환성 팁  " FontWeight="SemiBold" Foreground="{DynamicResource WarningTextBrush}" />
                                <Run Text="ZMK 표에서 사용하는 운영체제의 지원 여부를 확인하세요. Windows에서 브라우저·파일 탐색기 뒤로 가기가 동작하지 않으면 Alt+← 조합인 "/><Run Text="&amp;kp LA(LEFT)" FontFamily="Consolas" FontWeight="SemiBold" /><Run Text="도 사용할 수 있습니다." />
                            </TextBlock>
                        </Border>

                        <StackPanel>
                            <TextBlock Text="공식 문서" FontWeight="SemiBold" Margin="0,0,0,7" />
                            <TextBlock>
                                <Hyperlink NavigateUri="https://zmk.dev/docs/keymaps/list-of-keycodes"
                                           RequestNavigate="Hyperlink_RequestNavigate">ZMK 공식 키코드 목록 및 운영체제 호환성 표</Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="지연">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,12,8,0" FontWeight="Normal">
                    <StackPanel>
                        <Border Background="{DynamicResource InfoPanelBrush}" BorderBrush="{DynamicResource InfoBorderBrush}"
                                BorderThickness="1" CornerRadius="9" Padding="16,13" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="지연이란?" FontWeight="SemiBold" Foreground="{DynamicResource InfoTextBrush}" />
                                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="20"
                                           Text="키를 설정한 시간 이상 계속 눌러야 원래 동작을 실행하는 옵션입니다. 그 전에 손을 떼면 아무 동작도 하지 않습니다. 다시 누르면 처음부터 시간을 셉니다." />
                                <TextBlock Margin="0,7,0,0" TextWrapping="Wrap" LineHeight="20"
                                           Text="50~1000ms를 50ms 단위로 선택할 수 있습니다. 50ms는 0.05초, 500ms는 0.5초, 1000ms는 1초입니다." />
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="9" Padding="16,13" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="설정하고 키보드에 적용하기" FontWeight="SemiBold" />
                                <TextBlock Margin="0,7,0,0" TextWrapping="Wrap" LineHeight="21">
                                    <Run Text="1. " FontWeight="SemiBold" /><Run Text="배열에서 키를 클릭하고 원하는 키나 동작을 할당합니다." />
                                    <LineBreak />
                                    <Run Text="2. " FontWeight="SemiBold" /><Run Text="‘지연’을 체크하고 시간을 선택합니다." />
                                    <LineBreak />
                                    <Run Text="3. " FontWeight="SemiBold" /><Run Text="‘지연 적용’을 누릅니다. 키에 (500ms)처럼 시간이 표시됩니다." />
                                    <LineBreak />
                                    <Run Text="4. " FontWeight="SemiBold" /><Run Text="키맵을 저장하고 펌웨어를 빌드한 뒤 키보드에 설치합니다." />
                                </TextBlock>
                                <TextBlock Margin="0,7,0,0" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" LineHeight="20"
                                           Text="‘선택한 키 적용’·‘동작 적용’·‘원문 적용’도 현재 지연 설정을 함께 적용합니다. 키마다 서로 다른 시간을 지정할 수 있습니다." />
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="9" Padding="16,13" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="지연 키 사용 예시" FontWeight="SemiBold" />
                                <TextBlock Margin="0,7,0,0" TextWrapping="Wrap" LineHeight="20">
                                    <Run Text="부트로더 진입 (500ms)  " FontWeight="SemiBold" />
                                    <Run Text="0.5초 이상 계속 누르면 부트로더로 진입합니다. 0.5초 전에 떼면 실행하지 않아 실수로 누르는 것을 줄일 수 있습니다." />
                                </TextBlock>
                                <TextBlock Margin="0,7,0,0" TextWrapping="Wrap" LineHeight="20">
                                    <Run Text="A (300ms)  " FontWeight="SemiBold" />
                                    <Run Text="0.3초가 지나면 A 입력이 시작됩니다. 계속 누르는 동안 일반 키처럼 유지되고, 손을 떼면 입력을 해제합니다." />
                                </TextBlock>
                                <TextBlock Margin="0,7,0,0" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" LineHeight="20"
                                           Text="일반 키·수정키·미디어·마우스·Bluetooth·레이어 동작에 사용할 수 있습니다. 부트로더·시스템 재시작은 키가 있는 쪽 하프에만 적용됩니다." />
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="9" Padding="16,13" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="시간 변경·지연 해제" FontWeight="SemiBold" />
                                <TextBlock Margin="0,7,0,0" TextWrapping="Wrap" LineHeight="20"
                                           Text="시간을 바꾸고 ‘지연 적용’을 누르면 선택한 키에 반영됩니다. ‘지연’을 체크 해제한 뒤 적용하면 누르는 즉시 동작합니다. 변경 후에는 저장·빌드·키보드 설치가 필요합니다." />
                                <TextBlock Margin="0,7,0,0" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" LineHeight="20"
                                           Text="기존 부트로더·재시작의 500ms 설정도 같은 방법으로 변경·해제할 수 있습니다. 투명 키(&amp;trans)는 먼저 실행할 키나 동작을 선택하세요." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Button Grid.Row="2" Content="닫기" Width="92" HorizontalAlignment="Right"
                Margin="0,18,0,0" IsDefault="True" IsCancel="True" Click="Close_Click" />
    </Grid>
</Window>
