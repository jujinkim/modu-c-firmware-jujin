<Window x:Class="ModuKeymapStudio.RenameLayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="레이어 이름 변경" Width="440" Height="330" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Border Padding="24" Background="{DynamicResource PanelBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="레이어 이름 변경" FontSize="22" FontWeight="SemiBold" />
            <StackPanel Grid.Row="1" Margin="0,20,0,0">
                <TextBlock Text="Devicetree 노드 이름" Foreground="{DynamicResource MutedBrush}" />
                <TextBox x:Name="NodeNameBox" Margin="0,6,0,0" FontFamily="Consolas" />
                <TextBlock x:Name="DefaultNodeHint" Text="기본 레이어의 default_layer 노드명은 변경할 수 없습니다."
                           Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,4,0,0" Visibility="Collapsed" />
            </StackPanel>
            <StackPanel Grid.Row="2" Margin="0,14,0,0">
                <TextBlock Text="화면 표시 이름 (display-name)" Foreground="{DynamicResource MutedBrush}" />
                <TextBox x:Name="DisplayNameBox" Margin="0,6,0,0" />
            </StackPanel>
            <TextBlock Grid.Row="3" x:Name="ValidationText" Foreground="{DynamicResource DangerBrush}"
                       Margin="0,14,0,0" TextWrapping="Wrap" />
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="취소" Width="88" Margin="0,0,8,0" IsCancel="True" />
                <Button Content="변경" Width="88" Style="{StaticResource AccentButton}" Click="Rename_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
