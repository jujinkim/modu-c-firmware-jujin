<Window x:Class="ModuKeymapStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unofficial MODU Keymap Studio" Width="1680" Height="980" MinWidth="1280" MinHeight="820"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="82" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,7">
            <Border.Resources>
                <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                    <Setter Property="Padding" Value="10,5" />
                    <Setter Property="Margin" Value="2,0" />
                </Style>
                <Style x:Key="ToolbarAccentButton" TargetType="Button" BasedOn="{StaticResource AccentButton}">
                    <Setter Property="Padding" Value="11,5" />
                    <Setter Property="Margin" Value="3,0" />
                </Style>
            </Border.Resources>
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="44" Height="44" CornerRadius="11" Background="{DynamicResource AccentBrush}">
                        <TextBlock Text="M" Foreground="{DynamicResource AccentForegroundBrush}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,24,0" VerticalAlignment="Center">
                        <TextBlock Text="Unofficial MODU Keymap Studio" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Text="ZMK 키맵 네이티브 편집기" Foreground="{DynamicResource MutedBrush}" FontSize="12" />
                    </StackPanel>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="{DynamicResource PanelAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="5,3" Margin="3,0">
                        <StackPanel>
                            <TextBlock Text="파일" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="4,0,0,2" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="열기" Style="{StaticResource ToolbarButton}" Click="Open_Click" />
                                <Button Content="저장" Style="{StaticResource ToolbarButton}" Click="Save_Click" x:Name="SaveButton" />
                                <Button Content="다른 이름" Style="{StaticResource ToolbarButton}" Click="SaveAs_Click" x:Name="SaveAsButton" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource PanelAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="5,3" Margin="3,0">
                        <StackPanel>
                            <TextBlock Text="작업" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="4,0,0,2" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="↶ 실행 취소" Style="{StaticResource ToolbarButton}" Click="Undo_Click" x:Name="UndoButton" />
                                <Button Content="↷ 다시 실행" Style="{StaticResource ToolbarButton}" Click="Redo_Click" x:Name="RedoButton" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource PanelAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="5,3" Margin="3,0">
                        <StackPanel>
                            <TextBlock Text="레이어" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="4,0,0,2" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="＋ 추가" Style="{StaticResource ToolbarButton}" Click="AddLayer_Click" x:Name="AddLayerButton" />
                                <Button Content="이름 변경" Style="{StaticResource ToolbarButton}" Click="RenameLayer_Click" x:Name="RenameLayerButton" />
                                <Button Content="삭제" Style="{StaticResource ToolbarButton}" Click="DeleteLayer_Click" x:Name="DeleteLayerButton" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Button Content="전체보기" Style="{StaticResource ToolbarButton}" Margin="10,0,2,0"
                            Click="AllLayers_Click" x:Name="AllLayersButton" />
                    <Button Content="펌웨어 빌드" Style="{StaticResource ToolbarAccentButton}"
                            Click="Build_Click" x:Name="BuildButton" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="390" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,14,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="2,0,2,12">
                        <TextBlock DockPanel.Dock="Right" x:Name="DirtyText" Text="" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" FontWeight="SemiBold" />
                        <StackPanel>
                            <TextBlock x:Name="FileNameText" Text="키맵을 찾는 중…" Foreground="{DynamicResource AccentBrush}" FontSize="12" />
                            <TextBlock x:Name="LayerTitleText" Text="MODU 61키 배열" FontSize="24" FontWeight="SemiBold" Margin="0,3,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <TabControl Grid.Row="1" x:Name="LayerTabs" SelectionChanged="LayerTabs_SelectionChanged" Margin="0,0,0,14" Height="42" />
                    <Border Grid.Row="2" Background="{DynamicResource KeyboardSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="KeyboardPanel" MinWidth="1120" VerticalAlignment="Center" />
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="?" Width="29" Height="29" Padding="0"
                                    FontWeight="Bold" FontSize="15" ToolTip="K_·C_ 키코드 차이 도움말"
                                    Click="KeySelectionHelp_Click" />
                            <TextBlock Text="선택한 키" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock x:Name="SelectedKeyText" Text="키를 클릭해 바인딩을 편집하세요." Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,14" TextWrapping="Wrap" />

                        <DockPanel>
                            <TextBlock x:Name="PresetCountText" DockPanel.Dock="Right" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center" />
                            <TextBlock Text="키 찾기 · 한글/영문명/기호/ZMK 코드" FontWeight="SemiBold" />
                        </DockPanel>
                        <Grid Margin="0,7,0,7">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <ComboBox x:Name="CategoryBox" SelectionChanged="PresetFilter_Changed" />
                            <TextBox Grid.Column="1" x:Name="SearchBox" Margin="7,0,0,0" TextChanged="PresetFilter_Changed" ToolTip="예: 슬래시, forward slash, question mark, /, ?, FSLH, SLASH" />
                        </Grid>
                        <ListBox x:Name="PresetList" Height="190" MouseDoubleClick="PresetList_MouseDoubleClick" SelectionChanged="PresetList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4,3">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Binding}" FontFamily="Consolas" Foreground="{DynamicResource MutedBrush}" Margin="10,0,0,0" />
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Detail}" FontSize="10.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Detail}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button Content="선택한 키 적용" Margin="0,7,0,16" Click="ApplyPreset_Click" />

                        <Expander Header="부트로더·리셋 안내" IsExpanded="False" Margin="0,0,0,14">
                            <Border Background="{DynamicResource WarningPanelBrush}"
                                    BorderBrush="{DynamicResource WarningBorderBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,7,0,0">
                                <StackPanel>
                                    <TextBlock Foreground="{DynamicResource WarningTextBrush}" TextWrapping="Wrap" FontSize="11">
                                        <Run FontWeight="SemiBold" Text="설정: " />
                                        <Run Text="키를 선택한 뒤 시스템·전원 항목을 골라 ‘선택한 키 적용’을 누르거나 항목을 더블클릭하세요." />
                                    </TextBlock>
                                    <TextBlock Foreground="{DynamicResource WarningTextBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0">
                                        <Run FontWeight="SemiBold" Text="즉시 부트로더: " />
                                        <Run Text="키를 누르는 즉시 &amp;bootloader를 실행합니다." />
                                    </TextBlock>
                                    <TextBlock Foreground="{DynamicResource WarningTextBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,3,0,0">
                                        <Run FontWeight="SemiBold" Text="500ms 길게 누르기: " />
                                        <Run Text="0.5초 이상 계속 눌러야 부트로더 또는 시스템 재시작을 실행하며, 그 전에 떼면 아무 동작도 하지 않습니다." />
                                    </TextBlock>
                                    <TextBlock Foreground="{DynamicResource WarningTextBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0"
                                               Text="분할 키보드에서는 이 키가 위치한 하프에만 적용됩니다. 현재 MODU 보드는 공식 boot-mode retention 설정이 없어 부트로더 진입 대신 일반 재시작만 될 수 있습니다." />
                                </StackPanel>
                            </Border>
                        </Expander>

                        <Separator Background="{DynamicResource BorderBrush}" Margin="0,0,0,15" />
                        <TextBlock Text="동작별 입력" FontWeight="SemiBold" />
                        <ComboBox x:Name="BehaviorBox" Margin="0,7,0,8" SelectionChanged="BehaviorBox_SelectionChanged" />
                        <TextBlock x:Name="TargetLayerLabel" Text="대상 레이어" Foreground="{DynamicResource MutedBrush}" />
                        <ComboBox x:Name="TargetLayerBox" Margin="0,5,0,8" SelectedValuePath="Index" DisplayMemberPath="Label" />
                        <TextBlock x:Name="ArgumentLabel" Text="키 코드" Foreground="{DynamicResource MutedBrush}" />
                        <TextBox x:Name="ArgumentBox" Margin="0,5,0,8" FontFamily="Consolas" />
                        <Button Content="동작 적용" Click="ApplyBehavior_Click" Style="{StaticResource AccentButton}" Margin="0,2,0,14" />

                        <Expander Header="고급 원문 입력" IsExpanded="True">
                            <StackPanel Margin="0,8,0,0">
                                <TextBox x:Name="RawBindingBox" FontFamily="Consolas" />
                                <TextBlock Text="지원 목록 밖의 ZMK 바인딩도 한 줄 원문으로 입력할 수 있습니다." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,5,0,7" />
                                <Button Content="원문 적용" Click="ApplyRaw_Click" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource PanelAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="18,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="About" Padding="12,3" Margin="8,2,0,2" Click="About_Click" />
                <ComboBox DockPanel.Dock="Right" x:Name="ThemeBox" Width="88" Margin="12,2,0,2"
                          Padding="5,1" SelectionChanged="ThemeBox_SelectionChanged" />
                <TextBlock DockPanel.Dock="Right" Text="테마" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                <TextBlock DockPanel.Dock="Right" Text="MODU 61 · Windows x64" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                <TextBlock x:Name="StatusText" Text="준비" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
            </DockPanel>
        </Border>

        <Canvas x:Name="DragGhostLayer" Grid.RowSpan="3" Panel.ZIndex="1000"
                IsHitTestVisible="False" ClipToBounds="True" />
    </Grid>
</Window>
