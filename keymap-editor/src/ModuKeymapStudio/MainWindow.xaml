<Window x:Class="ModuKeymapStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unofficial MODU Keymap Studio" Width="1680" Height="980" MinWidth="1280" MinHeight="820"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="74" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,12">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="44" Height="44" CornerRadius="11" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="M" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,24,0" VerticalAlignment="Center">
                        <TextBlock Text="Unofficial MODU Keymap Studio" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Text="ZMK 키맵 네이티브 편집기" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                    </StackPanel>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="열기" Margin="4,0" Click="Open_Click" />
                    <Button Content="저장" Margin="4,0" Click="Save_Click" x:Name="SaveButton" />
                    <Button Content="다른 이름" Margin="4,0" Click="SaveAs_Click" x:Name="SaveAsButton" />
                    <Button Content="↶ 실행 취소" Margin="12,0,4,0" Click="Undo_Click" x:Name="UndoButton" />
                    <Button Content="↷ 다시 실행" Margin="4,0" Click="Redo_Click" x:Name="RedoButton" />
                    <Button Content="＋ 레이어" Margin="12,0,4,0" Click="AddLayer_Click" x:Name="AddLayerButton" />
                    <Button Content="레이어 삭제" Margin="4,0" Click="DeleteLayer_Click" x:Name="DeleteLayerButton" />
                    <Button Content="펌웨어 빌드" Style="{StaticResource AccentButton}" Margin="12,0,0,0" Click="Build_Click" x:Name="BuildButton" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="390" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,14,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="2,0,2,12">
                        <TextBlock DockPanel.Dock="Right" x:Name="DirtyText" Text="" Foreground="#9A6500" VerticalAlignment="Center" FontWeight="SemiBold" />
                        <StackPanel>
                            <TextBlock x:Name="FileNameText" Text="키맵을 찾는 중…" Foreground="{StaticResource AccentBrush}" FontSize="12" />
                            <TextBlock x:Name="LayerTitleText" Text="MODU 61키 배열" FontSize="24" FontWeight="SemiBold" Margin="0,3,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <TabControl Grid.Row="1" x:Name="LayerTabs" SelectionChanged="LayerTabs_SelectionChanged" Margin="0,0,0,14" Height="42" />
                    <Border Grid.Row="2" Background="#EEF1F5" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="KeyboardPanel" MinWidth="1120" VerticalAlignment="Center" />
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="?" Width="29" Height="29" Padding="0"
                                    FontWeight="Bold" FontSize="15" ToolTip="K_·C_ 키코드 차이 도움말"
                                    Click="KeySelectionHelp_Click" />
                            <TextBlock Text="선택한 키" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock x:Name="SelectedKeyText" Text="키를 클릭해 바인딩을 편집하세요." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,14" TextWrapping="Wrap" />

                        <DockPanel>
                            <TextBlock x:Name="PresetCountText" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" />
                            <TextBlock Text="키 찾기 · 한글/영문명/기호/ZMK 코드" FontWeight="SemiBold" />
                        </DockPanel>
                        <Grid Margin="0,7,0,7">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <ComboBox x:Name="CategoryBox" SelectionChanged="PresetFilter_Changed" />
                            <TextBox Grid.Column="1" x:Name="SearchBox" Margin="7,0,0,0" TextChanged="PresetFilter_Changed" ToolTip="예: 슬래시, forward slash, question mark, /, ?, FSLH, SLASH" />
                        </Grid>
                        <ListBox x:Name="PresetList" Height="190" MouseDoubleClick="PresetList_MouseDoubleClick" SelectionChanged="PresetList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4,3">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Binding}" FontFamily="Consolas" Foreground="{StaticResource MutedBrush}" Margin="10,0,0,0" />
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Detail}" FontSize="10.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Detail}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button Content="선택한 키 적용" Margin="0,7,0,16" Click="ApplyPreset_Click" />

                        <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,15" />
                        <TextBlock Text="동작별 입력" FontWeight="SemiBold" />
                        <ComboBox x:Name="BehaviorBox" Margin="0,7,0,8" SelectionChanged="BehaviorBox_SelectionChanged" />
                        <TextBlock x:Name="TargetLayerLabel" Text="대상 레이어" Foreground="{StaticResource MutedBrush}" />
                        <ComboBox x:Name="TargetLayerBox" Margin="0,5,0,8" SelectedValuePath="Index" DisplayMemberPath="Label" />
                        <TextBlock x:Name="ArgumentLabel" Text="키 코드" Foreground="{StaticResource MutedBrush}" />
                        <TextBox x:Name="ArgumentBox" Margin="0,5,0,8" FontFamily="Consolas" />
                        <Button Content="동작 적용" Click="ApplyBehavior_Click" Style="{StaticResource AccentButton}" Margin="0,2,0,14" />

                        <Expander Header="고급 원문 입력" IsExpanded="True">
                            <StackPanel Margin="0,8,0,0">
                                <TextBox x:Name="RawBindingBox" FontFamily="Consolas" />
                                <TextBlock Text="지원 목록 밖의 ZMK 바인딩도 한 줄 원문으로 입력할 수 있습니다." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,5,0,7" />
                                <Button Content="원문 적용" Click="ApplyRaw_Click" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="18,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="About" Padding="12,3" Margin="14,2,0,2" Click="About_Click" />
                <TextBlock DockPanel.Dock="Right" Text="MODU 61 · Windows x64" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                <TextBlock x:Name="StatusText" Text="준비" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
