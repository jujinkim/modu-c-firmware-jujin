<Window x:Class="ModuKeymapStudio.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About · Unofficial MODU Keymap Studio"
        Width="650" Height="700" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <Border Width="54" Height="54" CornerRadius="13" Background="{StaticResource AccentBrush}">
                <TextBlock Text="M" Foreground="White" FontSize="29" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Margin="15,1,0,0" VerticalAlignment="Center">
                <TextBlock Text="Unofficial MODU Keymap Studio" FontSize="22" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="by Jujin Kim" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Text="  ·  " Foreground="{StaticResource MutedBrush}" />
                    <TextBlock x:Name="VersionText" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Background="#EAF3FC" BorderBrush="#9BC4EA" BorderThickness="1"
                CornerRadius="9" Padding="16,13" Margin="0,22,0,13">
            <StackPanel>
                <TextBlock Text="임시 비공식 도구" FontWeight="SemiBold" Foreground="#094F91" />
                <TextBlock Margin="0,5,0,0" TextWrapping="Wrap" LineHeight="20"
                           Text="공식 키매퍼가 나오기 전에 제가 직접 빠르게 적용해 보려고 임시로 만든 비공식 도구입니다. 개인 사용 목적으로 만들어 심도 있는 테스트는 진행하지 않았으며, MODU-C 및 ZMK 프로젝트의 공식 앱이 아닙니다." />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="#FFF4E5" BorderBrush="#E7B66B" BorderThickness="1"
                CornerRadius="9" Padding="16,13" Margin="0,0,0,13">
            <StackPanel>
                <TextBlock Text="사용 전 주의" FontWeight="SemiBold" Foreground="#8A4B08" />
                <TextBlock Margin="0,5,0,0" TextWrapping="Wrap" LineHeight="20"
                           Text="이 프로그램의 사용, 키맵 변경, 펌웨어 빌드 및 플래싱으로 발생하는 문제나 손해는 사용자 책임입니다. 변경 전 원본 키맵과 정상 펌웨어를 백업하세요." />
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="9" Padding="16,13" Margin="0,0,0,17">
            <StackPanel>
                <TextBlock Text="지원 및 빌드 범위" FontWeight="SemiBold" />
                <TextBlock Margin="0,5,0,0" TextWrapping="Wrap" LineHeight="20"
                           Text="저장소의 빌드 스크립트가 Windows 전용이므로 Windows에서 EXE만 빌드하고 테스트했습니다. 이 앱은 .NET 8 기반이지만 WPF UI는 Windows 전용입니다. 다른 플랫폼에서는 필요한 UI 포팅과 빌드 구성을 직접 준비해 사용하세요." />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="4">
            <TextBlock Text="관련 링크" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
            <TextBlock Margin="0,4">
                <Hyperlink NavigateUri="https://github.com/jujinkim/modu-c-firmware-jujin"
                           RequestNavigate="Hyperlink_RequestNavigate">이 프로그램의 GitHub 저장소</Hyperlink>
            </TextBlock>
            <TextBlock Margin="0,4">
                <Hyperlink NavigateUri="https://github.com/22sh22/modu-c-firmware"
                           RequestNavigate="Hyperlink_RequestNavigate">원본 MODU-C 펌웨어 GitHub 저장소</Hyperlink>
            </TextBlock>
            <TextBlock Margin="0,4">
                <Hyperlink NavigateUri="https://erkeys.com/user-guide"
                           RequestNavigate="Hyperlink_RequestNavigate">MODU-C 키보드 사용자 매뉴얼</Hyperlink>
            </TextBlock>
        </StackPanel>

        <Button Grid.Row="5" Content="닫기" Width="92" HorizontalAlignment="Right"
                Margin="0,20,0,0" IsDefault="True" IsCancel="True" Click="Close_Click" />
    </Grid>
</Window>
