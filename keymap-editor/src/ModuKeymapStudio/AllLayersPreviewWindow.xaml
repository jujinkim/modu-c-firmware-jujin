<Window x:Class="ModuKeymapStudio.AllLayersPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="전체 레이어 미리보기" Width="1480" Height="900" MinWidth="1000" MinHeight="640"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="20,13">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="PNG로 복사" Click="CopyPng_Click" Margin="4,0" />
                    <Button Content="PNG로 저장" Click="SavePng_Click" Style="{StaticResource AccentButton}" Margin="4,0" />
                    <Button Content="닫기" Click="Close_Click" Margin="12,0,0,0" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="전체 레이어 미리보기" FontSize="21" FontWeight="SemiBold" />
                    <TextBlock x:Name="PreviewStatusText" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,3,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer x:Name="PreviewScrollViewer" Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Border x:Name="ExportSurface" Background="{DynamicResource WindowBrush}" Padding="24" MinWidth="1200">
                <StackPanel>
                    <TextBlock Text="MODU 전체 레이어" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock x:Name="ExportSubtitleText" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,4,0,18" />
                    <StackPanel x:Name="LayersPanel" />
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Window>
